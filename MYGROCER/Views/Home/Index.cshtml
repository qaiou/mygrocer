@model IEnumerable<MYGROCER.Models.ProductsModel>
@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<string?> ?? new List<string?>();
}

<div class="hero-section position-relative overflow-hidden"
     style="background: url('https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=2000&auto=format&fit=crop') no-repeat center center;
    background-size: cover;
    padding: 100px 0;
    min-height: 450px;">

    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0, 0, 0, 0.55); z-index: 1;"></div>

    <div class="container text-center position-relative text-white" style="z-index: 2;">
        <div class="d-flex align-items-center justify-content-center mb-3">
            <img src="~/images/trolley.jpeg" alt="MYGROCER Logo"
                 class="me-3 rounded shadow-sm"
                 style="height: 70px; width: auto; object-fit: contain; background: rgba(255,255,255,0.1); padding: 5px;"
                 onerror="this.style.display='none'" />

            <h1 class="display-4 fw-bold m-0 tracking-tight" style="font-family: 'Poppins', sans-serif;">
                <span class="text-white">MY</span><span style="color: #4cb02c;">GROCER</span>
            </h1>
        </div>

        <p class="lead mb-4 mx-auto style-subtext" style="max-width: 700px; font-size: 1.25rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
            Your one-stop online grocery store. Fresh produce, packaged goods, beverages and more — delivered directly to your door.
        </p>

        <a asp-controller="Products" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-5 shadow-sm rounded-pill">
            <i class="bi bi-grid-fill"></i> Shop Now
        </a>
    </div>
</div>

<div class="container mt-5">
    <h4 class="fw-bold mb-3">Shop by Category</h4>
    <div class="row g-3 mb-5">
        @foreach (var cat in categories)
        {
            <div class="col-6 col-md-3">
                <a asp-controller="Products" asp-action="Index" asp-route-category="@cat"
                   class="card text-center p-3 text-decoration-none text-dark shadow-sm hover-card">
                    <div style="font-size: 2.5rem">
                        @switch (cat)
                        {
                            case "Fresh Produce":
                                <text>🥬</text>
                                break;
                            case "Packaged Goods":

                                <text>📦</text>
                                break;
                            case "Beverages":

                                <text>🥤</text>
                                break;
                            case "Household":

                                <text>🏠</text>
                                break;
                            default:

                                <text>🛍️</text>
                                break;
                        }
                    </div>
                    <small class="fw-semibold mt-1">@cat</small>
                </a>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Featured Products</h4>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-success btn-sm">
            View All <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card h-100 @(product.IsInStock ? "" : "opacity-70 out-of-stock")">
                    <div class="text-center pt-3" style="font-size: 3rem">
                        @switch (product.Category)
                        {
                            case "Fresh Produce":
                                <text>🥬</text>
                                break;
                            case "Packaged Goods":

                                <text>📦</text>
                                break;
                            case "Beverages":

                                <text>🥤</text>
                                break;
                            case "Household":

                                <text>🧴</text>
                                break;
                            default:

                                <text>🛍️</text>
                                break;
                        }
                    </div>
                    <div class="card-body p-2 text-center">
                        <span class="badge bg-light text-dark border mb-1">@product.Category</span>
                        <p class="card-title fw-semibold small mb-1">@product.Name</p>
                        <p class="price-tag mb-1 fw-bold text-success">RM @product.BasePrice.ToString("F2")</p>
                        @if (!product.IsInStock)
                        {
                            <span class="badge bg-secondary w-100">Out of Stock</span>
                        }
                        else
                        {
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId"
                               class="btn btn-primary btn-sm w-100 mt-1">View</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="bg-light mt-5 py-5">
    <div class="container text-center">
        <h4 class="fw-bold mb-4">Why Shop With Us?</h4>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="fs-1">🚚</div>
                <h6 class="fw-bold">Fast Delivery</h6>
                <p class="text-muted small">Same-day delivery available for orders before 12pm.</p>
            </div>
            <div class="col-md-4">
                <div class="fs-1">💳</div>
                <h6 class="fw-bold">Secure Payment</h6>
                <p class="text-muted small">FPX, Credit/Debit Card, and Cash on Delivery supported.</p>
            </div>
            <div class="col-md-4">
                <div class="fs-1">🥇</div>
                <h6 class="fw-bold">Best Prices</h6>
                <p class="text-muted small">MYDIN-inspired pricing — affordable everyday essentials.</p>
            </div>
        </div>
    </div>
</div>