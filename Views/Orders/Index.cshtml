@model IEnumerable<MYGROCER.Models.Order>

@{
    ViewData["Title"] = "Admin - Manage Orders";
}

<div class="container py-4">
    <h3 class="mb-3">Orders</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No orders found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Order</th>
                        <th>Order Date</th>
                        <th>Product</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Unit Price (RM)</th>
                        <th class="text-end">Line Total (RM)</th>
                        <th>Shipping Status</th>
                        <th>Payment</th>
                        <th class="text-end">Order Total (RM)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var items = o.Items ?? new List<MYGROCER.Models.OrderItem>();
                        var first = true;
                        foreach (var it in items)
                        {
                            <tr>
                                @if (first)
                                {
                                    <td rowspan="@(items.Count())" class="align-middle">
                                        <strong>#@o.OrderId</strong><br />
                                        <small class="text-muted">Txn: @(o.TransactionId ?? "—")</small>
                                    </td>
                                    <td rowspan="@(items.Count())" class="align-middle">
                                        @o.OrderDate.ToLocalTime().ToString("g")<br />
                                        <small class="text-muted">Cust: @o.CustomerId</small>
                                    </td>
                                }
                                <td>
                                    <div class="fw-semibold">@it.ProductName</div>
                                </td>
                                <td class="text-end">@it.Quantity</td>
                                <td class="text-end">RM @it.UnitPrice.ToString("F2")</td>
                                <td class="text-end">RM @(it.UnitPrice * it.Quantity).ToString("F2")</td>
                                <td>
                                    <form asp-controller="Admin" asp-action="UpdateShipping" method="post" class="d-flex gap-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderItemId" value="@it.OrderItemId" />
                                        @{
                                            var status = it.ShippingStatus ?? "Pending";
                                        }
                                        <select name="status" class="form-select form-select-sm" style="width:120px;">
                                            <option value="Pending" selected="@(status == "Pending")">Pending</option>
                                            <option value="Shipped" selected="@(status == "Shipped")">Shipped</option>
                                            <option value="Delivered" selected="@(status == "Delivered")">Delivered</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                    </form>
                                </td>
                                @if (first)
                                {
                                    <td rowspan="@(items.Count())" class="align-middle">@(o.PaymentMethod ?? "—")</td>
                                    <td rowspan="@(items.Count())" class="text-end align-middle fw-bold">RM @o.TotalAmount.ToString("F2")</td>
                                    first = false;
                                }
                            </tr>
                        }
                        if (!items.Any())
                        {
                            <tr>
                                <td><em>No items</em></td>
                                <td colspan="7" class="text-end">RM @o.TotalAmount.ToString("F2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>