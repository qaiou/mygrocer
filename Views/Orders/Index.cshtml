@model IEnumerable<MYGROCER.Models.Order>

@{
    ViewData["Title"] = "Orders (Admin)";
}

<div class="container py-4">
    <h3 class="mb-3">Orders</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No orders found.</div>
    }
    else
    {
        <div class="accordion" id="ordersAccordion">
            @foreach (var o in Model)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading@o.OrderId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@o.OrderId" aria-expanded="false" aria-controls="collapse@o.OrderId">
                            Order #@o.OrderId — RM @o.TotalAmount.ToString("F2") — @o.OrderDate.ToLocalTime().ToString("g")
                        </button>
                    </h2>
                    <div id="collapse@o.OrderId" class="accordion-collapse collapse" aria-labelledby="heading@o.OrderId" data-bs-parent="#ordersAccordion">
                        <div class="accordion-body">
                            <ul class="list-group">
                                @foreach (var it in o.Items ?? new List<MYGROCER.Models.OrderItem>())
                                {
                                    var status = it.ShippingStatus ?? "Pending";
                                    var badgeClass = status switch
                                    {
                                        "Delivered" => "bg-primary",
                                        "Shipped" => "bg-success",
                                        "Pending" => "bg-secondary",
                                        _ => "bg-secondary"
                                    };

                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold">@it.ProductName</div>
                                            <div class="small text-muted">Qty: @it.Quantity</div>
                                            <div class="small mt-1">
                                                <span class="badge @badgeClass">@status</span>
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <div class="mb-1 fw-semibold">RM @((it.UnitPrice * it.Quantity).ToString("F2"))</div>

                                            <form asp-controller="Admin" asp-action="UpdateShipping" method="post" class="d-inline-flex align-items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderItemId" value="@it.OrderItemId" />
                                                @{
                                                    var pendingSelected = status == "Pending";
                                                    var shippedSelected = status == "Shipped";
                                                    var deliveredSelected = status == "Delivered";
                                                }
                                                <select name="status" class="form-select form-select-sm me-2" style="width:140px;">
                                                    <option value="Pending" selected='@(pendingSelected ? "selected" : null)'>Pending</option>
                                                    <option value="Shipped" selected='@(shippedSelected ? "selected" : null)'>Shipped</option>
                                                    <option value="Delivered" selected='@(deliveredSelected ? "selected" : null)'>Delivered</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>

                            <div class="mt-3 d-flex justify-content-between">
                                <div class="small text-muted">Payment: @(o.PaymentMethod ?? "—")</div>
                                <div class="fw-bold">Total: RM @o.TotalAmount.ToString("F2")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>