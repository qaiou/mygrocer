@model MYGROCER.Models.ProductsModel
@{
    ViewData["Title"] = "Add New Product";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-action="AdminIndex" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <h4 class="fw-bold mb-0">Add New Product</h4>
    </div>

    <div class="card p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Fresh Milk 1L" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Short product description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label fw-semibold"></label>
                <select asp-for="Category" class="form-select">
                    <option value="">-- Select Category --</option>
                    <option value="Fresh Produce">Fresh Produce</option>
                    <option value="Packaged Goods">Packaged Goods</option>
                    <option value="Beverages">Beverages</option>
                    <option value="Household">Household</option>
                </select>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BasePrice" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">RM</span>
                        <input asp-for="BasePrice" class="form-control" type="number"
                               step="0.01" min="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                    <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                <input asp-for="ImageUrl" class="form-control" placeholder="/images/product.jpg (optional)" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success flex-grow-1">
                    <i class="bi bi-plus-lg"></i> Add Product
                </button>
                <a asp-action="AdminIndex" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
