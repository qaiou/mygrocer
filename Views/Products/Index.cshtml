@model IEnumerable<MYGROCER.Models.ProductsModel>
@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as List<string?> ?? new List<string?>();
    var currentCategory = ViewBag.CurrentCategory as string;
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="container mt-4">
    <h3 class="fw-bold mb-4"><i class="bi bi-grid"></i> All Products</h3>

    <!-- Search + Filter Bar -->
    <div class="row g-2 mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="hidden" name="category" value="@currentCategory" />
                <input type="text" name="search" value="@currentSearch"
                       class="form-control" placeholder="Search products..." />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" asp-route-category="@currentCategory" class="btn btn-outline-secondary">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </form>
        </div>
        <div class="col-md-6 d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentCategory) ? "btn-success" : "btn-outline-success")">
                All
            </a>
            @foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-category="@cat" asp-route-search="@currentSearch"
                   class="btn btn-sm @(currentCategory == cat ? "btn-success" : "btn-outline-success")">
                    @cat
                </a>
            }
        </div>
    </div>

    <!-- Results count -->
    <p class="text-muted small mb-3">
        Showing @Model.Count() product(s)
        @if (!string.IsNullOrEmpty(currentCategory)) { <text> in <strong>@currentCategory</strong></text> }
        @if (!string.IsNullOrEmpty(currentSearch)) { <text> matching "<strong>@currentSearch</strong>"</text> }
    </p>

    <!-- Product Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="fs-1">🔍</div>
            <h5>No products found.</h5>
            <p class="text-muted">Try a different search or category.</p>
            <a asp-action="Index" class="btn btn-primary">Clear Filter</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 @(product.IsInStock ? "" : "out-of-stock")">
                        <div class="text-center pt-4 pb-2" style="font-size: 3.5rem">
                            @switch (product.Category)
                            {
                                case "Fresh Produce": <text>🥬</text> break;
                                case "Packaged Goods": <text>📦</text> break;
                                case "Beverages": <text>🥤</text> break;
                                case "Household": <text>🧴</text> break;
                                default: <text>🛍️</text> break;
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <span class="badge badge-category mb-2 align-self-start">@product.Category</span>
                            <h6 class="card-title fw-bold">@product.Name</h6>
                            <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                            <div class="mt-auto">
                                <p class="price-tag mb-1">RM @product.BasePrice.ToString("F2")</p>
                                @if (!product.IsInStock)
                                {
                                    <button class="btn btn-secondary btn-sm w-100" disabled>Out of Stock</button>
                                }
                                else
                                {
                                    <p class="text-success small mb-2">
                                        <i class="bi bi-check-circle"></i> In Stock (@product.StockQuantity left)
                                    </p>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@product.ProductId"
                                           class="btn btn-outline-primary btn-sm flex-grow-1">Details</a>
                                        <button class="btn btn-primary btn-sm flex-grow-1">
                                            <i class="bi bi-cart-plus"></i> Add
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
