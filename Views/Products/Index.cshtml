@model IEnumerable<MYGROCER.Models.ProductsModel>
@{
    ViewData["Title"] = "Products";
    var currentCategory = ViewBag.CurrentCategory as string;
    var currentSearch = ViewBag.CurrentSearch as string;
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
}

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 100vh;">
    <div class="container">
        <h3 class="fw-bold mb-4"><i class="bi bi-grid"></i> All Products</h3>

        <div class="row g-4">

            <div class="col-lg-3 col-md-4">
                <div class="card border-0 shadow-sm p-4" style="border-radius: 12px; position: sticky; top: 20px;">
                    <h5 class="fw-bold mb-4">Filters</h5>

                    <form asp-action="Index" method="get">
                        <input type="hidden" name="search" value="@currentSearch" />

                        <div class="mb-4 pb-4 border-bottom">
                            <label class="form-label fw-semibold text-muted small text-uppercase mb-3">Price Range</label>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="text-muted small">RM</span>
                                <input type="number" name="minPrice" value="@minPrice"
                                       class="form-control form-control-sm" placeholder="Min" style="border-radius: 6px;">
                                <span class="text-muted small">to</span>
                                <input type="number" name="maxPrice" value="@maxPrice"
                                       class="form-control form-control-sm" placeholder="Max" style="border-radius: 6px;">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted small text-uppercase mb-3">Categories</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="catAll" value=""
                                           @(string.IsNullOrEmpty(currentCategory) ? "checked" : "")>
                                    <label class="form-check-label small" for="catAll">All Categories</label>
                                </div>
                                
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="cat1" value="Fresh Produce" @(currentCategory == "Fresh Produce" ? "checked" : "")>
                                    <label class="form-check-label small" for="cat1">Fresh Produce</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="cat2" value="Food & Beverages" @(currentCategory == "Food & Beverages" ? "checked" : "")>
                                    <label class="form-check-label small" for="cat2">Food & Beverages</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="cat3" value="Packaged Goods" @(currentCategory == "Packaged Goods" ? "checked" : "")>
                                    <label class="form-check-label small" for="cat3">Packaged Goods</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="cat4" value="Home & Living" @(currentCategory == "Home & Living" ? "checked" : "")>
                                    <label class="form-check-label small" for="cat4">Home & Living</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="cat5" value="Health & Beauty" @(currentCategory == "Health" ? "checked" : "")>
                                    <label class="form-check-label small" for="cat5">Health & Beauty</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="category" id="cat6" value="Pets" @(currentCategory == "Pets" ? "checked" : "")>
                                    <label class="form-check-label small" for="cat6">Pets</label>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-semibold shadow-sm mb-2" style="border-radius: 6px;">
                            <i class="bi bi-funnel-fill"></i> Apply Filters
                        </button>

                        @if (!string.IsNullOrEmpty(currentCategory) || minPrice.HasValue || maxPrice.HasValue || !string.IsNullOrEmpty(currentSearch))
                        {
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 fw-semibold" style="border-radius: 6px;">
                                Clear Filters
                            </a>
                        }
                    </form>
                </div>
            </div>

            <div class="col-lg-9 col-md-8">

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 shadow-sm" style="border-radius: 12px;">
                    <span class="text-muted small fw-semibold">
                        Showing <span class="text-success">@Model.Count()</span> product(s)
                        @if (!string.IsNullOrEmpty(currentCategory)) { <text> in <strong>@currentCategory</strong></text> }
                        @if (!string.IsNullOrEmpty(currentSearch)) { <text> matching "<strong>@currentSearch</strong>"</text> }
                    </span>
                    <form asp-action="Index" method="get" class="d-flex gap-2">
                        <input type="hidden" name="category" value="@currentCategory" />
                        <input type="hidden" name="minPrice" value="@minPrice" />
                        <input type="hidden" name="maxPrice" value="@maxPrice" />
                        <input type="text" name="search" value="@currentSearch"
                               class="form-control form-control-sm" placeholder="Search products..."
                               style="width: 200px; border-radius: 6px;">
                        <button class="btn btn-success btn-sm px-3" style="border-radius: 6px;">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="fs-1">🔍</div>
                        <h5>No products found.</h5>
                        <p class="text-muted">Try a different search or category.</p>
                        <a asp-action="Index" class="btn btn-success">Clear Filters</a>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                        @foreach (var product in Model)
                        {
                            <div class="col">
                                <div class="card h-100 border-0 shadow-sm product-card @(product.IsInStock ? "" : "out-of-stock")"
                                     style="border-radius: 12px; overflow: hidden;">
                                    <div class="p-3 bg-light d-flex align-items-center justify-content-center"
                                         style="height: 180px; position: relative;">
                                        <img src="@product.ImageUrl" alt="@product.Name"
                                             style="max-height: 100%; max-width: 100%; object-fit: contain;"
                                             onerror="this.src='/images/trolley.jpeg'" />
                                        <span class="badge bg-success-subtle text-success position-absolute top-0 start-0 m-3 border border-success-subtle"
                                              style="font-size: 0.7rem;">@product.Category</span>
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">@product.Name</h6>
                                            <p class="text-muted small mb-2" style="font-size: 0.8rem;">@product.Description</p>
                                            <span class="fw-bold text-success fs-5">RM @product.BasePrice.ToString("F2")</span>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            @if (!product.IsInStock)
                                            {
                                                <button class="btn btn-secondary btn-sm w-100" disabled>Out of Stock</button>
                                            }
                                            else
                                            {
                                                <p class="text-success small mb-0 d-none">
                                                    <i class="bi bi-check-circle"></i> In Stock (@product.StockQuantity left)
                                                </p>
                                                <a asp-action="Details" asp-route-id="@product.ProductId"
                                                   class="btn btn-light btn-sm flex-grow-1 fw-semibold" style="border-radius: 6px;">Details</a>
                                                <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                                    <input type="hidden" name="quantity" value="1" />
                                                    <button type="submit" class="btn btn-success btn-sm px-3" style="border-radius: 6px;">
                                                        <i class="bi bi-cart-plus-fill"></i> Add
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.1) !important;
    }
</style>