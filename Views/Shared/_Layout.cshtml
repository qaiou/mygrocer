@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MYGROCER</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            :root {
                --green: #2e7d32;
                --green-light: #4caf50;
                --orange: #f57c00;
            }

            .navbar {
                background: var(--green) !important;
                height: 64px;
            }

            .navbar-brand {
                font-weight: 800;
                font-size: 1.5rem;
                color: white !important;
            }

                .navbar-brand span {
                    color: #ffcc02;
                }

            .nav-link {
                color: rgba(255,255,255,0.9) !important;
                }

                .nav-link:hover {
                    color: #ffcc02 !important;
                }

            .btn-primary {
                background: var(--green);
                border-color: var(--green);
            }

                .btn-primary:hover {
                    background: #1b5e20;
                    border-color: #1b5e20;
                }

            .card {
                border: none;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                transition: transform 0.2s;
            }

                .card:hover {
                    transform: translateY(-4px);
                }

            .badge-category {
                background: var(--green-light);
                color: white;
                font-size: 0.75rem;
            }

            .price-tag {
                color: var(--orange);
                font-size: 1.2rem;
                font-weight: 700;
            }

            .out-of-stock {
                opacity: 0.6;
            }

            .hero-section {
                background: linear-gradient(135deg, var(--green), #1b5e20);
                color: white;
                padding: 60px 0;
            }

            footer {
                background: #1b5e20;
                color: white;
                padding: 20px 0;
                margin-top: 60px;
            }

            .singleton-badge {
                background: #e8f5e9;
                border: 1px solid var(--green-light);
                border-radius: 4px;
                padding: 4px 10px;
                font-size: 0.75rem;
                color: var(--green);
            }

            /* Search input */
            .navbar input::placeholder {
                color: rgba(255,255,255,0.65) !important;
            }

            .navbar input:focus {
                background: rgba(255,255,255,0.22) !important;
                color: white !important;
                box-shadow: none !important;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid px-4 d-flex align-items-center gap-0" style="height: 100%;">

            <a class="navbar-brand flex-shrink-0 me-3" asp-controller="Home" asp-action="Index">
                <img src="~/images/trolley.jpeg" alt="Trolley"
                     class="me-2 rounded"
                     style="height: 30px; width: auto; object-fit: contain;"
                     asp-append-version="true" />
                MY<span>GROCER</span>
            </a>

            <ul class="navbar-nav d-flex flex-row align-items-center gap-1 flex-shrink-0">
                <li class="nav-item">
                    <a class="nav-link px-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Home
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link px-2 dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid"></i> Products
                    </a>
                    <ul class="dropdown-menu shadow border-0 mt-2" style="border-radius: 12px;">
                        <li>
                            <a class="dropdown-item py-2 fw-semibold text-success"
                               asp-controller="Products" asp-action="Index">
                                <i class="bi bi-arrow-right-short"></i> All Products
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index" asp-route-category="Fresh Produce">🥬 Fresh Produce</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index" asp-route-category="Food & Beverages">🧃 Food & Beverages</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index" asp-route-category="Packaged Goods">📦 Packaged Goods</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index" asp-route-category="Home & Living">🧹 Home & Living</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index" asp-route-category="Health & Beauty">💊 Health & Beauty</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index" asp-route-category="Pets">🐾 Pets</a></li>
                    </ul>
                </li>
            </ul>

            <form asp-controller="Products" asp-action="Index" method="get"
                  class="d-flex align-items-center mx-3"
                  style="flex: 1; min-width: 0;">
                <div class="input-group" style="height: 36px;">
                    <input type="text" name="search" value="@ViewBag.CurrentSearch"
                           class="form-control form-control-sm"
                           placeholder="Search by name or category..."
                           style="border-radius: 8px 0 0 8px; border-color: rgba(255,255,255,0.3);
                    background: rgba(255,255,255,0.15); color: white; font-size: 0.85rem;" />
                    <button type="submit" class="btn btn-sm"
                            style="background: #ffcc02; border-color: #ffcc02;
                        color: #1b5e20; font-weight: 600; border-radius: 0 8px 8px 0; padding: 0 14px;">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                    {
                        <a asp-controller="Products" asp-action="Index"
                           class="btn btn-sm ms-1"
                           style="background: transparent; border: 1px solid rgba(255,255,255,0.4);
                            color: white; border-radius: 8px;">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
                <div style="display:none;">
                    @Html.AntiForgeryToken()
                </div>
            </form>

            <ul class="navbar-nav d-flex flex-row align-items-center gap-1 flex-shrink-0">
                <li class="nav-item">
                    <a class="nav-link px-2" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-cart3"></i> Cart
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2" asp-controller="Products" asp-action="AdminIndex">
                        <i class="bi bi-shield-lock"></i> Admin
                    </a>
                </li>
                
                @{
                    var customerName = Context.Session.GetString("CustomerName");
                }

                @if (!string.IsNullOrEmpty(customerName))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link btn btn-outline-light btn-sm ms-1 px-3 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> @customerName
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><a class="dropdown-item py-2" asp-controller="Cart" asp-action="MyOrders">My Orders</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-light btn-sm ms-1 px-3" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-person"></i> Register / Log in
                        </a>
                    </li>
                }
            </ul>

        </div>
    </nav>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="loginForm">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" required />
                        </div>
                        <div id="loginError" class="text-danger small mb-2" style="display:none;"></div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Log in</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @RenderSection("Hero", required: false)

    <div class="container-fluid p-0">
        <main role="main" class="flex-grow-1">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto" style="background:#1b5e20; color: white;">
        <div class="container text-center py-3">
            <p class="mb-0">© 2026 MYGROCER Holdings Berhad — CSE 6234 Software Design | Group 1 TT3L</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function(){
            // login modal submit handler
            var loginForm = document.getElementById('loginForm');
            if(loginForm){
                loginForm.addEventListener('submit', function(ev){
                    ev.preventDefault();
                    var formData = new FormData(loginForm);
                    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    var token = tokenInput ? tokenInput.value : '';
                    fetch('/Account/Login', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                        body: new URLSearchParams(formData)
                    })
                    .then(function(response){
                        // try parse JSON, otherwise fallback to text
                        return response.text().then(function(text){
                            try { return JSON.parse(text); }
                            catch { return { success: false, message: text || 'Unexpected response from server' }; }
                        });
                    })
                    .then(function(j){
                        if(j && j.success){
                            var modalEl = document.getElementById('loginModal');
                            var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                            modal.hide();
                            // slight delay to ensure session cookie is set
                            setTimeout(function(){ location.reload(); }, 200);
                        } else {
                            var err = document.getElementById('loginError'); err.style.display = 'block'; err.textContent = j.message || 'Login failed';
                        }
                    }).catch(function(err){
                        var e = document.getElementById('loginError'); e.style.display = 'block'; e.textContent = 'Network or server error';
                    });
                });
            }

            // global function to add to cart via AJAX
            window.addToCartAjax = function(productId, qty){
                var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value;
                fetch('/Cart/Add', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: 'productId=' + encodeURIComponent(productId) + '&quantity=' + encodeURIComponent(qty)
                }).then(r => r.json()).then(function(j){
                    if(j.requireLogin){
                        var modalEl = document.getElementById('loginModal');
                        var modal = new bootstrap.Modal(modalEl); modal.show();
                    } else if(j.success){
                        // optionally show a toast or reload cart link
                        location.href = '/Cart/Index';
                    }
                });
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>